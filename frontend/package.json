{
  "name": "archaeology-field-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "repoKind": "frontend-only",
  "scripts": {
    "setup": "npm install && node ../scripts/seed.mjs",
    "seed": "node ../scripts/seed.mjs",
    "seed:reset": "node ../scripts/seed.mjs --reset",
    "predev": "node ../scripts/seed.mjs --no-install",
    "dev": "vite",
    "prebuild": "node ../scripts/seed.mjs --no-install",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vue-tsc": "^2.0.7"
  }
}
