{
  "name": "archaeology-field-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repoKind": "frontend-only",
  "scripts": {
    "setup": "node scripts/seed-cli.mjs",
    "seed": "node scripts/seed-cli.mjs",
    "seed:force": "node scripts/seed-cli.mjs --force",
    "preflight": "node scripts/seed-cli.mjs --preflight",
    "verify:flow": "node scripts/verify-flow.mjs",
    "dev": "node scripts/seed-cli.mjs && vite",
    "build": "vue-tsc --noEmit && node scripts/seed-cli.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vue-tsc": "^2.0.7"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.63.6"
  }
}
